<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>BeyondTheCode.Api</RootNamespace>

        <!-- Container image built by `dotnet publish -t:PublishContainer` (no Dockerfile).
             Registry, repository and tag are set by scripts/build-image.sh. -->
        <ContainerRepository>beyond-the-code-api</ContainerRepository>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.1" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    </ItemGroup>

</Project>
